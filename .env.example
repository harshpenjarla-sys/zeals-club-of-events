# =================================================================
# ZEAL'S CLUB OF EVENTS - ENVIRONMENT CONFIGURATION
# =================================================================

# Server Port
PORT=5000

# JSON Web Token Secret
JWT_SECRET=zeal-secret-jwt-key-2026-production

# Node Environment
NODE_ENV=development

# MySQL Database Configuration (Optional - SQLite embedded is active by default)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=zeals_events
DB_PORT=3306

# Institutional Email SMTP (Optional for automated mail dispatches)
SMTP_HOST=smtp.zeals.edu
SMTP_PORT=587
SMTP_USER=no-reply@zeals.edu
SMTP_PASS=
